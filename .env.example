# Keep real credentials only in .env (never in Git or chat).
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs
DISCORD_ALLOWED_USER_IDS=
# Comma-separated user IDs allowed to grant RustDesk access with /add
DISCORD_ADMIN_USER_IDS=
# Additional grants only; relative paths are resolved from the working directory
ALLOWED_USERS_FILE=data/allowed-users.json
# Explicit absolute path to this user's RustDesk IPC socket
RUSTDESK_SOCKET_PATH=
COOLDOWN_MS=30000
